# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://integritysecuresolutions.co.uk

# --- Where form submissions are sent -----------------------------------------
# Accepts a comma-separated list, so one enquiry can reach several inboxes.
ENQUIRY_TO_EMAIL=your.address@gmail.com,info@integritysecuresolutions.co.uk

# --- Option 1: your own domain mailbox (SMTP) --------------------------------
# The details your email host gives you. See EMAIL-SETUP.md.
# NEVER commit the password — it belongs in .env.local, which git ignores.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@integritysecuresolutions.co.uk
SMTP_PASS=

# Optional. Defaults to SMTP_USER, which is what most mail servers require.
ENQUIRY_FROM_EMAIL=

# --- Option 2: Resend (used only if SMTP is unset, or if SMTP fails) ---------
# Needs an API key from https://resend.com/api-keys and DNS records on the
# domain. ENQUIRY_FROM_EMAIL is required with this option.
RESEND_API_KEY=

# With none of the above set, submissions are validated and logged to the
# server console only — useful in development, never enough in production.

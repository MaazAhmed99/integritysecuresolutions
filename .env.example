# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://integritysecuresolutions.com

# --- Where form submissions are sent -----------------------------------------
# Accepts a comma-separated list, so one enquiry can reach several inboxes.
ENQUIRY_TO_EMAIL=your.address@gmail.com

# --- Option 1: Resend (the configured route) ---------------------------------
# Sends without needing a mailbox. Create a key at https://resend.com/api-keys
# and verify a SUBDOMAIN (send.yourdomain.com) so its SPF cannot clash with the
# forwarding records on the root domain. See EMAIL-SETUP.md.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=website@send.integritysecuresolutions.com

# --- Option 2: your own domain mailbox (SMTP) --------------------------------
# Only needed if you later have a real mailbox. Tried FIRST when set, with
# Resend above as the automatic fallback.
# NEVER commit the password — it belongs in .env.local, which git ignores.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@integritysecuresolutions.com
SMTP_PASS=

# With none of the above set, submissions are validated and logged to the
# server console only — useful in development, never enough in production.

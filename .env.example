# Public site URL — used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://integritysecuresolutions.co.uk

# Optional: transactional email for the enquiry / quote / careers forms.
# Without these, submissions are validated and logged to the server console only.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info@integritysecuresolutions.co.uk
ENQUIRY_FROM_EMAIL=website@integritysecuresolutions.co.uk
